#include <winver.h>

1 ICON "mirroar.ico"

1 VERSIONINFO
FILEVERSION 0,3,0,0
PRODUCTVERSION 0,3,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "MirRoar Server - PC remote desktop for Meta Quest"
      VALUE "ProductName", "MirRoar"
      VALUE "FileVersion", "0.3.0"
      VALUE "ProductVersion", "0.3.0"
      VALUE "OriginalFilename", "MirRoarServer.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 0x04B0
  END
END
